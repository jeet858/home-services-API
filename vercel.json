{
  "version": 2,
  "regions": ["bom1"],
  "functions": {
    "src/api/index.js": {
      "maxDuration": 30
    }
  },
  "builds": [
    {
      "src": "src/api/index.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/src/api/index.js"
    }
  ]
}
